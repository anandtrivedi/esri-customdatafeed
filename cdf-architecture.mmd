flowchart LR
    subgraph Clients["ArcGIS Clients"]
        PRO[ArcGIS Pro<br/>Desktop]
        WEB[ArcGIS Web App<br/>JS API]
        MOBILE[ArcGIS Field Maps<br/>Mobile]
    end

    subgraph Server["ArcGIS Server (AWS EC2)"]
        REST[REST API<br/>HTTPS]
        CDF[CDF Runtime<br/>FeatureServer]
        PROVIDER[Custom Data Feed Provider<br/>model.js]
    end

    subgraph Databricks["Databricks Workspace"]
        SQL[Databricks SQL Warehouse<br/>SQL Analytics]
        DELTA[(Delta Lake<br/>Unity Catalog)]
        LAKE[Lakebase<br/>PostgreSQL + PostGIS<br/>14-16ms latency]
    end

    %% Client connections
    PRO -->|HTTPS| REST
    WEB -->|HTTPS| REST
    MOBILE -->|HTTPS| REST

    %% Server flow
    REST --> CDF
    CDF --> PROVIDER

    %% Read-only path (Databricks)
    PROVIDER -->|getData<br/>Read-Only<br/>50K+ rows| SQL
    SQL --> DELTA

    %% Editable path (Lakebase) - bidirectional
    PROVIDER -->|getData<br/>Read| LAKE
    PROVIDER -.->|editData<br/>Write NEW| LAKE

    %% Styling
    classDef clientStyle fill:#4285f4,stroke:#1a73e8,stroke-width:2px,color:#fff
    classDef serverStyle fill:#34a853,stroke:#0f9d58,stroke-width:2px,color:#fff
    classDef readStyle fill:#fbbc04,stroke:#f9ab00,stroke-width:2px,color:#000
    classDef editStyle fill:#ea4335,stroke:#d93025,stroke-width:2px,color:#fff
    classDef deltaStyle fill:#e8eaed,stroke:#5f6368,stroke-width:2px,color:#000

    class PRO,WEB,MOBILE clientStyle
    class REST,CDF,PROVIDER serverStyle
    class SQL,DELTA readStyle
    class LAKE editStyle
