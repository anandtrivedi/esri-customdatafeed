# Databricks Custom Data Feed Provider — Environment Configuration
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------
# Databricks Connection — Default Profile (REQUIRED for single-workspace)
# ---------------------------------------------------------------
# These define the IMPLICIT default workspace profile used when a
# Feature Service is created without a `workspace` service param.
# Single-workspace deployments only need these.

# Your Databricks workspace hostname (without https://)
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com

# Default SQL Warehouse HTTP path (overridable per-service via
# `warehouseHttpPath` service parameter — see README.md "Multiple Databricks Workspaces" section)
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id

# Personal Access Token (PAT) — generate at: Settings > Developer > Access tokens
DATABRICKS_ACCESS_TOKEN=dapi_your_pat_here

# ---------------------------------------------------------------
# Multi-Workspace Configuration (OPTIONAL)
# ---------------------------------------------------------------
# To expose Feature Services from multiple Databricks workspaces, define
# named profiles in ~/.databrickscfg (or a custom path) and reference
# them via the `workspace` service parameter when creating each service.
#
# Example .databrickscfg:
#   [WORKSPACE_A]
#   host  = workspace-a.cloud.databricks.com
#   token = dapiXXXX
#
#   [WORKSPACE_B]
#   host          = workspace-b.cloud.databricks.com
#   client_id     = <service-principal-client-id>
#   client_secret = <service-principal-secret>
#
# See README.md "Multiple Databricks Workspaces" section for full setup.
#
# Override the config file location (defaults to ~/.databrickscfg):
# DATABRICKS_CONFIG_FILE=/opt/arcgis/server/usr/.databrickscfg

# ---------------------------------------------------------------
# Lakebase Authentication (OPTIONAL — for editable services)
# ---------------------------------------------------------------
# By default, the provider auto-generates short-lived OAuth tokens
# using the PAT above. You only need these if auto-generation
# doesn't work for your setup.
# LAKEBASE_PASSWORD=your-oauth-token-or-password
# LAKEBASE_USER=databricks

# ---------------------------------------------------------------
# Query Defaults (OPTIONAL — can also be set per-service)
# ---------------------------------------------------------------
# DATABRICKS_SRID=4326
# DATABRICKS_MAX_RECORD_COUNT=2000
# DATABRICKS_QUERY_TIMEOUT=120000

# ---------------------------------------------------------------
# Connection Pool Tuning (OPTIONAL)
# ---------------------------------------------------------------
# DATABRICKS_POOL_MIN=2
# DATABRICKS_POOL_MAX=10
# LAKEBASE_POOL_MIN=2
# LAKEBASE_POOL_MAX=10
# LAKEBASE_SSL_VERIFY=false

# ---------------------------------------------------------------
# Security (OPTIONAL)
# ---------------------------------------------------------------
# ArcGIS user authentication — validates req._user from CDF runtime
# ENABLE_USER_AUTH=false

# Audit logging — writes JSON lines to log file
# ENABLE_AUDIT_LOG=false
# AUDIT_LOG_FILE=./logs/audit.log
