# Databricks Connection Configuration
# Copy this file to .env and fill in your actual values

# Databricks Credentials (REQUIRED)
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_ACCESS_TOKEN=dapi_your_token_here

# Table Configuration (REQUIRED)
DATABRICKS_DEFAULT_TABLE=your_catalog.your_schema.your_table
DATABRICKS_GEOMETRY_COLUMN=geometry
DATABRICKS_ID_FIELD=id

# Optional Configuration
DATABRICKS_SRID=4326
DATABRICKS_MAX_RECORD_COUNT=2000

# Authentication & Authorization (OPTIONAL)
# Set to 'true' to enable user authentication via ArcGIS
ENABLE_USER_AUTH=false

# Audit Logging (OPTIONAL)
# Set to 'true' to enable audit logging of all requests
ENABLE_AUDIT_LOG=false
AUDIT_LOG_FILE=./logs/audit.log

# Simple Testing Authentication (OPTIONAL - for development/testing only)
# Set to 'true' to enable simple token-based authentication for testing
ENABLE_SIMPLE_AUTH=false
# Generate a random token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIMPLE_AUTH_TOKEN=your-test-token-here
