{
  "name": "databricks-geospatial-provider",
  "arcgisVersion": "12.0.0",
  "parentServiceType": "FeatureServer",
  "customdataRuntimeVersion": "1",
  "type": "provider",
  "editingEnabled": true,
  "properties": {
    "serviceParameters": [
      {
        "key": "workspace",
        "label": "Databricks Workspace Profile",
        "description": "e.g. SP"
      },
      {
        "key": "warehouseHttpPath",
        "label": "SQL Warehouse HTTP Path (Lakehouse)",
        "description": "e.g. /sql/1.0/warehouses/1857dd2a594736e4"
      },
      {
        "key": "tableName",
        "label": "Table Name (Lakehouse)",
        "description": "e.g. main.geospatial.us_cell_towers"
      },
      {
        "key": "geometryColumn",
        "label": "Geometry Column",
        "description": "e.g. geom"
      },
      {
        "key": "idField",
        "label": "ID Field",
        "description": "e.g. objectid"
      },
      {
        "key": "geometryFormat",
        "label": "Geometry Format (Lakehouse)",
        "description": "e.g. WKT, WKB, GEOJSON, or GEOMETRY"
      },
      {
        "key": "timeColumn",
        "label": "Time Column",
        "description": "e.g. event_time"
      },
      {
        "key": "lakebaseHost",
        "label": "Lakebase Host",
        "description": "e.g. ep-bold-dawn-xxxx.database.cloud.databricks.com"
      },
      {
        "key": "lakebasePort",
        "label": "Lakebase Port",
        "description": "e.g. 5432"
      },
      {
        "key": "lakebaseDatabase",
        "label": "Lakebase Database",
        "description": "e.g. databricks_postgres"
      },
      {
        "key": "lakebaseSchema",
        "label": "Lakebase Schema",
        "description": "e.g. geo_demo"
      },
      {
        "key": "lakebaseTable",
        "label": "Lakebase Table",
        "description": "e.g. cases_editable"
      },
      {
        "key": "maxRecordCount",
        "label": "Max Record Count",
        "description": "e.g. 2000"
      },
      {
        "key": "srid",
        "label": "Spatial Reference ID",
        "description": "e.g. 4326"
      },
      {
        "key": "editingEnabled",
        "label": "Editing Enabled (Lakebase)",
        "description": "e.g. true"
      }
    ]
  },
  "fileName": "databricks-geospatial-provider.cdpk"
}
