# Sample .databrickscfg for multi-workspace CDF provider deployment.
#
# This file holds credentials for ADDITIONAL Databricks workspaces beyond
# your default one. Your default workspace is configured via env vars in
# .env (DATABRICKS_SERVER_HOSTNAME + DATABRICKS_ACCESS_TOKEN).
#
# Copy to ~/.databrickscfg (or wherever DATABRICKS_CONFIG_FILE points),
# chmod 600, fill in your hosts and credentials. Reference profiles by
# name from each Feature Service's `workspace` service parameter.
#
# See README.md "Multiple Workspaces or OAuth M2M" section for full setup,
# including service principal creation for OAuth M2M.
#
# Each profile picks ONE auth mode — either token (PAT) or
# client_id + client_secret (OAuth M2M), not both. Different profiles
# can use different modes; mix freely.

# -----------------------------------------------------------------
# Named workspace — PAT auth
# -----------------------------------------------------------------
[WORKSPACE_A]
host  = workspace-a.cloud.databricks.com
token = dapiAAAAAAAAAAAAAAAAA

# -----------------------------------------------------------------
# Named workspace — OAuth M2M (recommended for production)
#
# Create a service principal in the workspace, generate an OAuth secret,
# and grant the SP CAN_USE on the SQL warehouse + database access on
# any Lakebase instances.
# -----------------------------------------------------------------
[WORKSPACE_B]
host          = workspace-b.cloud.databricks.com
client_id     = <service-principal-client-id>
client_secret = <service-principal-secret>

# -----------------------------------------------------------------
# OPTIONAL — [DEFAULT] profile
# -----------------------------------------------------------------
# You only need this if you want default-workspace credentials in this
# file instead of env vars. The CDF provider checks .databrickscfg
# [DEFAULT] before falling back to DATABRICKS_SERVER_HOSTNAME +
# DATABRICKS_ACCESS_TOKEN env vars. Most setups leave this out and use
# env vars for the default; uncomment if you'd rather everything live
# in this one file.
#
# [DEFAULT]
# host  = your-default-workspace.cloud.databricks.com
# token = dapiXXXXXXXXXXXXXXXXX
