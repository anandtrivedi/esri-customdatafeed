digraph CDF_Architecture {
    // Graph settings
    rankdir=LR;
    nodesep=0.6;
    ranksep=1.0;
    bgcolor="#FFFFFF";
    fontname="Arial";
    fontsize=12;
    label="ArcGIS Custom Data Feed — Databricks + Lakebase Architecture";
    labelloc=t;
    labeljust=c;
    fontsize=16;

    // Default node styling
    node [shape=box, style="filled,rounded", fontname="Arial", fontsize=10, color="#333333"];
    // Default edge styling - MUST set explicit color for Lucid Chart visibility
    edge [color="#333333", fontname="Arial", fontsize=9, penwidth=1.5];

    // ── ArcGIS Clients (Blue) ──
    subgraph cluster_clients {
        label="ArcGIS Clients";
        style="filled,rounded";
        fillcolor="#E8F0FE";
        color="#4285F4";
        fontname="Arial";
        fontsize=11;
        fontcolor="#1A73E8";

        pro [label="ArcGIS Pro\n(Desktop)", fillcolor="#C6DAFC", color="#4285F4", fontcolor="#1A237E"];
        webapp [label="ArcGIS Web App\nJS API (Browser)", fillcolor="#C6DAFC", color="#4285F4", fontcolor="#1A237E"];
        fieldmaps [label="ArcGIS Field Maps\n(Mobile)", fillcolor="#C6DAFC", color="#4285F4", fontcolor="#1A237E"];
    }

    // ── ArcGIS Server (Green) ──
    subgraph cluster_server {
        label="ArcGIS Server (AWS EC2)";
        style="filled,rounded";
        fillcolor="#E6F4EA";
        color="#34A853";
        fontname="Arial";
        fontsize=11;
        fontcolor="#137333";

        restapi [label="REST API\n(HTTPS)", fillcolor="#B7E1CD", color="#34A853", fontcolor="#0D652D"];
        cdfruntime [label="CDF Runtime\nFeatureServer", fillcolor="#B7E1CD", color="#34A853", fontcolor="#0D652D"];
        provider [label="CDF Provider\nmodel.js", fillcolor="#A8DAB5", color="#34A853", fontcolor="#0D652D"];
    }

    // ── Databricks Workspace (Right) ──
    subgraph cluster_databricks {
        label="Databricks Workspace";
        style="filled,rounded";
        fillcolor="#FFF8E1";
        color="#F9AB00";
        fontname="Arial";
        fontsize=11;
        fontcolor="#E37400";

        // Read-only path (Gold/Yellow)
        sqlwarehouse [label="Databricks SQL\nWarehouse", fillcolor="#FFF2CC", color="#F9AB00", fontcolor="#7F6003"];
        deltalake [label="Delta Lake\nUnity Catalog", shape=cylinder, fillcolor="#FFE082", color="#F9AB00", fontcolor="#7F6003"];

        // Editable path (Red - NEW)
        lakebase [label="Lakebase\nPostgreSQL + PostGIS\n14-16ms latency", fillcolor="#FFCDD2", color="#D32F2F", fontcolor="#B71C1C"];
    }

    // ── Client to Server Connections ──
    pro -> restapi [label="HTTPS", color="#4285F4"];
    webapp -> restapi [label="HTTPS", color="#4285F4"];
    fieldmaps -> restapi [label="HTTPS", color="#4285F4"];

    // ── Server Internal Flow ──
    restapi -> cdfruntime [label="query/\napplyEdits", color="#34A853"];
    cdfruntime -> provider [label="getData()\neditData()", color="#34A853"];

    // ── Read-Only Path (Gold) ──
    provider -> sqlwarehouse [label="getData()\nRead-Only\n50K+ rows", color="#F9AB00", penwidth=2.0];
    sqlwarehouse -> deltalake [label="SQL", color="#F9AB00", penwidth=2.0];

    // ── Editable Path (Red - NEW) ──
    provider -> lakebase [label="getData()\nRead", color="#D32F2F", penwidth=2.0];
    provider -> lakebase [label="editData()\nWrite (NEW)", color="#D32F2F", style=dashed, penwidth=2.5];

    // ── Lakebase ↔ Delta Lake Sync ──
    deltalake -> lakebase [label="Synced Tables\n(auto-sync)", color="#9E9E9E", style=dashed, penwidth=1.5, dir=both];
}
